# App Configuration
APP_NAME=BlogApi
SERVER_PORT=8080

# Database Configuration (H2 in-memory mode)
DB_URL=jdbc:h2:mem:blogdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=

# JPA / Hibernate Configuration
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
JPA_HIBERNATE_DDL_AUTO=update

# H2 Web Console (Browser UI: http://localhost:8080/h2-console)
H2_CONSOLE_ENABLED=true
H2_CONSOLE_PATH=/h2-console
